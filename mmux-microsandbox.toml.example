# Microsandbox node config example.
#
# This file shows portable sandbox runtime config plus Microsandbox-specific
# setup assets. Coder interaction profiles are built into mmux; do not repeat
# cmd, prompt markers, busy markers, or action keys here unless you
# intentionally want to change the built-in profile.
#
# Copy this file to the config path you pass as --node-config, or use it as a
# reference for example-backends/microsandbox/mmux.toml.

[sandbox.runtime]
# memory_mib = 1024
# cpus = 2

[microsandbox.assets]
mmux_version = "v0.1.0"
scripts_dir = "./mmux_sources/scripts"
assets_dir = "./mmux_sources/assets"

[sandbox.network]
default_egress = "deny"
default_ingress = "deny"
# The launcher automatically allows the controller URL when it targets the
# sandbox host alias, including the URL port. Add rules here only for extra
# access that this sandbox should have.
# For narrow runtime access to a service, prefer domain rules:
# [[sandbox.network.egress]]
# action = "allow"
# destination_domain = "api.openai.com"
# protocol = "udp"
# ports = [53]
#
# [[sandbox.network.egress]]
# action = "allow"
# destination_domain = "api.openai.com"
# protocol = "tcp"
# ports = [443]
# trust_host_cas = true

[[sandbox.secrets]]
env = "MMUX_CONTROLLER_TOKEN"
value_from = "host.MMUX_WIRE_TOKEN"
allowed_host = "host.microsandbox.internal"
placeholder = "$MSB_MMUX_CONTROLLER_TOKEN"
inject_headers = false
inject_basic_auth = false
inject_query = false
inject_body = false
require_tls_identity = false

# [[sandbox.secrets]]
# env = "OPENAI_API_KEY"
# value_from = "host.OPENAI_API_KEY"
# allowed_host = "api.openai.com"
# placeholder = "$MSB_OPENAI_API_KEY"
# inject_headers = true
# inject_basic_auth = false
# inject_query = false
# inject_body = false
# require_tls_identity = true
