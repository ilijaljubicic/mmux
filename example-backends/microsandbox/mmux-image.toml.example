# Runtime-only config for a prepared Docker/OCI image.
#
# Use this when the image already contains the guest toolchain and coder CLIs:
# tmux, bash, procps/ps, mmux at /usr/local/bin/mmux, and any profile commands
# you want to use such as codex, opencode, kimi, or claude.
#
# No setup scripts are declared here, so launch does not need installer egress.

[microsandbox.runtime]
image = "your-mmux-node-image:tag"
# memory_mib = 1024
# cpus = 2

[microsandbox.assets]
tmux_conf = "./mmux_sources/assets/tmux.conf"

[microsandbox.network]
default_egress = "deny"
default_ingress = "deny"
# The launcher automatically allows the controller URL when it targets
# host.microsandbox.internal, including the URL port. No installer network is
# opened by this config.

[[microsandbox.secrets]]
env = "MMUX_CONTROLLER_TOKEN"
value_from = "host.MMUX_TOKEN"
allowed_host = "host.microsandbox.internal"
placeholder = "$MSB_MMUX_CONTROLLER_TOKEN"
inject_headers = false
inject_basic_auth = false
inject_query = false
inject_body = false
require_tls_identity = false
